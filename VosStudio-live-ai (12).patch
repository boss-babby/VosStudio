+      vg.reason = sc >= 0.99 ? "author id" : sc >= 0.8 ? "name + affiliation" : sc >= 0.7 ? "name + context" : "initials";
+      vg.safe = sc >= 0.99;
+      vg.apply = vg.safe;
+      out.push_back(vg);
+    }
+  }
+  rankVariants(out);
+  return out;
+}
