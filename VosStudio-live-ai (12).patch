+        else if (startsWith(key, "cal:")) wed.tableSetColAlign(key[4]);
+        else if (key == "deltbl") wed.tableDeleteTable();
+        else if (key == "w50") wed.setFigureWidth(50);
+        else if (key == "w75") wed.setFigureWidth(75);
