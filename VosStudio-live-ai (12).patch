+      {"svg", "Export"}, {"pdf", "Export"}, {"png", "Export"}, {"copyfig", "Export"}, {"viewany", "Export"}, {"figall", "Export"}, {"viewsvg", "Export"}, {"viewpdf", "Export"}, {"viewpng", "Export"},
