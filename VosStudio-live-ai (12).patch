+  uc.lpszExtraInfo = extraB.data(); uc.dwExtraInfoLength = DWORD(extraB.size() - 1);
+  if (!WinHttpCrackUrl(wu.c_str(), 0, 0, &uc)) { out.err = "invalid address"; return false; }
