+  HANDLE h = GetClipboardData(fmt);
+  if (h) {
+    const char* p = static_cast<const char*>(GlobalLock(h));
+    SIZE_T n = GlobalSize(h);
+    if (p) { out.assign(p, strnlen(p, n)); GlobalUnlock(h); }
+  }
+  CloseClipboard();
+  return out;
+}
