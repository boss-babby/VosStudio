+        yy += 36 * s;
+        ui.line(pr.x + 8 * s, yy, pr.r() - 8 * s, yy, ui.c.border, 1);
+        yy += 2 * s;
+      }
+      for (auto& it : items) {
+        if (it.label[0] == '-') { ui.line(pr.x + 8 * s, yy + 3 * s, pr.r() - 8 * s, yy + 3 * s, ui.c.border, 1); yy += 7 * s; continue; }
+        Rect rr{pr.x + 4 * s, yy, pr.w - 8 * s, 26 * s};
