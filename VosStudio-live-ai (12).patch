+// ------------------------------------------------------------------ small helpers
+PdfItem* App::readerItem() {
+  if (!rd || rd->doc.itemId.empty()) return nullptr;
+  return P->library.find(rd->doc.itemId);
+}
+
+int App::readerRecord() {
+  PdfItem* it = readerItem();
+  if (!it || !hasCorpus()) return -1;
