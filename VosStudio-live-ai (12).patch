+void App::liveClose() {
+  liveSaveToChat();
+  liveDisconnect(false);
+  live.open = false;
+  live.talk = false;
+  live.queue.clear();
+  live.pendingText.clear();
+  live.pendingResults.clear();
+  live.log.clear();
+  live.error.clear();
+  live.changes = 0;
+  live.reconnects = 0;
+  live.tokens = -1;
+  live.focusWanted = false;
+  live.savedEntries = 0;
+  live.turnCalls = live.nudges = 0;
+  if (live.inputId && ui.focus == live.inputId) ui.focus = 0;
+}
