+      std::stable_sort(scored.begin(), scored.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+      int shown = 0;
+      for (auto& sc : scored) {
+        if (shown++ >= 8) break;
+        const Record& rr = P->corpus.recs[size_t(sc.second)];
+        Rect r2{content.x + 4 * s, yy, content.w - 8 * s, 44 * s};
