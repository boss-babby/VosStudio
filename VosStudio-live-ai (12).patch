+  forEachRange(*this, [&](Para& p, size_t a, size_t b) {
+    if (b <= a) { for (auto& s : p.spans) { s.fmt = 0; } p.style = PStyle::Body; p.align = PAlign::Left; p.level = 0; return; }
+    applyFmt(p, a, b, [](Span& s) { s.fmt = 0; s.link.clear(); });
+  });
+  typingSet = false;
+  changed();
+}
