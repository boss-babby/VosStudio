+# Builds the Windows executable with MinGW-w64 on Linux and runs the portable core tests on every push and pull
+# request. Tagged pushes (v*) also attach the .exe and a portable zip to a GitHub release.
+name: CI
+on:
+  push:
+    branches: ["**"]
+    tags: ["v*"]
+  pull_request:
+
+jobs:
+  tests:
+    name: Core tests (Linux, g++)
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build and run the test programs
+        run: make test -j2
+      - name: Validate the Word export against the Open XML schemas
+        # The Open XML SDK validator (packaged as a CLI by mikeebowen/OOXML-Validator) applies the same schema rules
+        # Word does; an empty JSON array means no errors. Prints the errors and fails otherwise.
+        run: |
+          make docx-samples
+          curl -sSL -o /tmp/ooxmlv.zip https://github.com/mikeebowen/OOXML-Validator/releases/download/v2.1.6/linux-x64.zip
+          mkdir -p /tmp/ooxmlv && unzip -q -o /tmp/ooxmlv.zip -d /tmp/ooxmlv && chmod +x /tmp/ooxmlv/OOXMLValidatorCLI
+          for f in build/host/sample.docx build/host/stress.docx; do
+            out=$(/tmp/ooxmlv/OOXMLValidatorCLI "$PWD/$f" Microsoft365)
+            echo "$f: $out"
+            [ "$out" = "[]" ] || exit 1
+          done
+      - name: Keep the logs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-logs
+          path: build/host/*.log
+          if-no-files-found: ignore
+
+  windows-exe:
+    name: Windows build (MinGW-w64 cross)
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install the cross compiler
+        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends g++-mingw-w64-x86-64-posix
+      - name: Build
+        run: CXXFLAGS=-O2 make -j2 CROSS=x86_64-w64-mingw32-
+      - name: Version
+        id: ver
+        run: echo "v=$(sed -n 's/.*VOS_VERSION_STR "\(.*\)".*/\1/p' src/win/version.h)" >> "$GITHUB_OUTPUT"
+      - name: Portable zip
+        run: |
+          mkdir -p dist/VOSStudio-${{ steps.ver.outputs.v }}
+          cp VOSStudio.exe README.md LICENSE dist/VOSStudio-${{ steps.ver.outputs.v }}/
+          cp -r docs/samples dist/VOSStudio-${{ steps.ver.outputs.v }}/samples || true
+          (cd dist && zip -r VOSStudio-${{ steps.ver.outputs.v }}-portable.zip VOSStudio-${{ steps.ver.outputs.v }})
+      - uses: actions/upload-artifact@v4
+        with:
+          name: VOSStudio-${{ steps.ver.outputs.v }}
+          path: |
+            VOSStudio.exe
+            dist/*.zip
+      - name: Release (tags only)
+        if: startsWith(github.ref, 'refs/tags/v')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: |
+            VOSStudio.exe
+            dist/*.zip
+          generate_release_notes: true
+
+  installer:
+    name: Installer (Inno Setup on Windows)
+    needs: windows-exe
+    if: startsWith(github.ref, 'refs/tags/v')
+    runs-on: windows-2022
+    steps:
+      - uses: actions/checkout@v4
+      - name: Version
+        id: ver
+        shell: bash
+        run: echo "v=$(sed -n 's/.*VOS_VERSION_STR "\(.*\)".*/\1/p' src/win/version.h)" >> "$GITHUB_OUTPUT"
+      - uses: actions/download-artifact@v4
+        with:
+          name: VOSStudio-${{ steps.ver.outputs.v }}
+      - name: Compile the installer
+        shell: pwsh
+        run: |
+          choco install innosetup --no-progress -y
+          & "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe" /DAppVersion=${{ steps.ver.outputs.v }} installer\VOSStudio.iss
+      - uses: softprops/action-gh-release@v2
+        with:
+          files: installer/Output/*.exe
