+string fileUrl(const string& path) {
+  string o = "file:///";
+  for (char c : path) {
+    if (c == '\\') o += '/';
+    else if (isalnum(uint8_t(c)) || c == '/' || c == ':' || c == '.' || c == '-' || c == '_' || c == '~') o += c;
+    else { char b[8]; snprintf(b, sizeof b, "%%%02X", uint8_t(c)); o += b; }
+  }
+  return o;
+}
