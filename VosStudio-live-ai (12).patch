+  ui.text({r.x + 30 * s, r.y, r.w - 2 * bw - 42 * s, r.h}, txt, 11.5f * s, active ? ui.c.text : ui.c.textDim, AL_LEFT, active ? 600 : 400);
+  L.space(4 * s);
+}
