+      t += "<p class=\"t" + std::to_string(headingLevel(b.p.style)) + "\"><a href=\"#h" + std::to_string(k) + "\">" + htmlEsc(headingPrefix(d, hn, k)) + spansHtml(b.p.spans) + "</a></p>\n";
