+      {"chartspdf", 0}, {"geolayer", 0}, {"geofill", 0}, {"geodenstyle", 0}, {"geodenmeasure", 0}, {"geosel", 0}, {"figpanels", 0}, {"figopt", 0}, {"figzoom", 0},
+      {"svg", 0}, {"pdf", 0}, {"png", 0}, {"viewsvg", 0}, {"viewpdf", 0}, {"viewpng", 0}, {"shot", 0}, {"viewshot", 0}, {"oaquery", 0}, {"oamax", 0}, {"oafrom", 0},
