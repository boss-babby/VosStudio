+
+void App::drawLiveOrb() {
+  float s = ui.s;
+  Rect o = liveOrbRect();
+  float cx = o.x + o.w / 2, cy = o.y + o.h / 2, R0 = o.w / 2;
+  auto& A = live.orb;
