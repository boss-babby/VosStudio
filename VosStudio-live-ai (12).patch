+        ui.text({rr.x + 10 * s, rr.y, rr.w - 14 * s, rr.h}, it.label, 12.5f * s, !it.enabled ? ui.c.textFaint : it.danger ? ui.c.danger : ui.c.text);
+        if (it.sub) ui.icon("chev-right", rr.r() - 12 * s, rr.y + rr.h / 2, 11 * s, ui.c.textDim, 2.f);
