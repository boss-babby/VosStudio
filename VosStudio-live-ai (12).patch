+string romanLower(int n) {
+  static const char* ones[] = {"", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix"};
+  static const char* tens[] = {"", "x", "xx", "xxx", "xl", "l", "lx", "lxx", "lxxx", "xc"};
+  if (n <= 0 || n >= 100) return std::to_string(n);
+  return string(tens[n / 10]) + ones[n % 10];
+}
