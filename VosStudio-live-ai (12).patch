+  for (size_t k = 0; k < d.blocks.size(); k++) {
+    const Block& b = d.blocks[k];
+    bool front = b.kind == Block::Paragraph && (b.p.style == PStyle::Title || b.p.style == PStyle::Subtitle || b.p.style == PStyle::Meta);
+    if (!front && !frontDone) {
